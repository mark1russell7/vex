{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/vex",
  "version": "0.9.1",
  "description": "Vex: typed spreadsheet formulas over domain objects. The kernel and the typed builder.",
  "keywords": [
    "typescript",
    "spreadsheet",
    "formulas",
    "expression-language",
    "dsl",
    "computed-fields",
    "rules-engine",
    "declarative",
    "layout",
    "functional-programming"
  ],
  "homepage": "https://mark1russell7.github.io/vex/",
  "bugs": {
    "url": "https://github.com/mark1russell7/vex/issues"
  },
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/vex.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "!src/**/*.test.ts",
    "!src/__golden__",
    "!src/test-support.ts",
    "!src/fc-setup.ts"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run -c vitest.bench.config.ts --reporter=verbose",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "bench:gate": "node bench/gate.ts"
  },
  "dependencies": {
    "@mark1russell7/coeval": "^0.4.2"
  },
  "devDependencies": {
    "@mark1russell7/cue": "github:mark1russell7/cue",
    "@mark1russell7/optional": "github:mark1russell7/optional",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
