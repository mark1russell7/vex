{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/vex-mcp",
  "version": "0.16.0",
  "description": "The MCP server of Vex: the catalog of the domains, and tools that check, evaluate, explain and compile a program as JSON.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "vex-mcp": "./src/main.ts"
  },
  "files": [
    "build",
    "src",
    "!src/**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "bin": {
      "vex-mcp": "./build/main.js"
    },
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/vex.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://mark1russell7.github.io/vex/",
  "keywords": [
    "vex",
    "mcp",
    "model-context-protocol",
    "claude",
    "spreadsheet"
  ],
  "license": "MIT",
  "dependencies": {
    "@mark1russell7/vex": "workspace:*",
    "@mark1russell7/vex-compiler": "workspace:*",
    "@mark1russell7/vex-domains": "workspace:*",
    "@mark1russell7/service": "^0.6.0",
    "@procedures/client": "^0.44.0",
    "@procedures/mcp-server": "^0.44.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mark1russell7/cue": "github:mark1russell7/cue",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
