---
/**
 * The page of the Vex sheet app. The app takes the whole window, so this page does not use the layout of the docs.
 */
import "@fontsource-variable/atkinson-hyperlegible-next";
import "@fontsource-variable/atkinson-hyperlegible-mono";
import "../../styles/tokens.css";
import "@vex/sheet-app/src/ui/sheet.css";
import SheetAppPage from "../../components/SheetAppPage.tsx";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const site = "https://mark1russell7.github.io";
const title = "Vex Sheet: a spreadsheet with typed formulas";
const description = "A spreadsheet in the browser on the Vex engine: one formula for each column, typed columns, rows in a tree, and error values that explain themselves.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${site}${base}app/`} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${site}${base}app/`} />
    <meta property="og:image" content={`${site}${base}og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#1f3fbf" />
    <script is:inline>
      // The app uses the theme that the reader chose on the docs.
      try {
        const t = localStorage.getItem("starlight-theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <style is:global>
      html, body { margin: 0; background: var(--color-page); }
      *, *::before, *::after { box-sizing: border-box; }
      /* The heading and the summary are in the static page. They show while the app loads (and when JavaScript is off). */
      .app-intro {
        position: fixed;
        inset: 0;
        display: grid;
        place-content: center;
        gap: 0.75rem;
        padding-block: 2rem;
        padding-left: max(16px, env(safe-area-inset-left, 0px));
        padding-right: max(16px, env(safe-area-inset-right, 0px));
        text-align: center;
        font-family: var(--font-sans);
        color: var(--color-ink);
        background: var(--color-page);
      }
      .app-intro h1 { margin: 0; font-size: clamp(1.5rem, 4vw, 2.25rem); line-height: 1.2; text-wrap: balance; }
      .app-intro p { margin: 0 auto; max-width: 60ch; color: var(--color-ink-secondary); line-height: 1.5; }
      .app-intro a { color: var(--color-accent-strong); }
      /* The app has its own header and h1. When the app is on the page (Astro removes "ssr"), the intro goes away. */
      body:has(astro-island:not([ssr])) .app-intro { display: none; }
    </style>
  </head>
  <body>
    <SheetAppPage client:only="react" docsHref={base} />
    <!-- The intro comes after the island. Before the app starts, the island is empty, so the first h1 is the intro's.
         After the app starts, the first h1 is the app's own visible h1, and the intro is hidden. -->
    <div class="app-intro">
      <h1>{title}</h1>
      <p>{description}</p>
      <p>Write one formula for a column, and each row shows its value. A wrong value shows an error that names its cause.</p>
      <noscript><p>The app needs JavaScript. Read about Vex at <a href={base}>the docs</a>.</p></noscript>
    </div>
  </body>
</html>
