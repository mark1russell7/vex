{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/vex-compiler",
  "version": "0.17.0",
  "description": "The Vex compiler: generated JavaScript for Vex programs, at run time and at build time, with the results of the interpreter.",
  "keywords": [
    "vex",
    "compiler",
    "codegen",
    "jit",
    "spreadsheet",
    "typescript"
  ],
  "homepage": "https://mark1russell7.github.io/vex/",
  "bugs": {
    "url": "https://github.com/mark1russell7/vex/issues"
  },
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/vex.git",
    "directory": "packages/compiler"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "!src/**/*.test.ts",
    "!src/__golden__"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:gate": "node bench/gate.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@mark1russell7/cue": "github:mark1russell7/cue",
    "@mark1russell7/vex-domains": "workspace:*",
    "@mark1russell7/vex-testkit": "workspace:*",
    "@types/node": "^26.6.4",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@mark1russell7/vex": "workspace:*"
  }
}
