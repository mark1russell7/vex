{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "e2e/**/*.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "vitest.doctest.config.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "src/content.config.ts",
    "dist",
    ".astro"
  ]
}
