{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/vex-domains",
  "version": "0.5.0",
  "description": "Vex domains: 2D vectors, named-component vectors, colors, angles, numbers and booleans.",
  "keywords": [
    "vex",
    "vector",
    "vec2",
    "color",
    "angle",
    "domain",
    "typescript"
  ],
  "homepage": "https://mark1russell7.github.io/vex/",
  "bugs": {
    "url": "https://github.com/mark1russell7/vex/issues"
  },
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/vex.git",
    "directory": "packages/domains"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "!src/**/*.test.ts",
    "!src/__golden__",
    "!src/test-support.ts",
    "!src/fc-setup.ts"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@mark1russell7/cue": "github:mark1russell7/cue",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@mark1russell7/vex": "workspace:*"
  }
}
