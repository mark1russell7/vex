{
  "$schema": "./node_modules/@mark1russell7/ste-lint/ste.config.schema.json",
  "include": [
    "README.md",
    "CLAUDE.md",
    "docs/**/*.{md,mdx}",
    "spec/**/*.md",
    "packages/*/README.md",
    "packages/site/**/*.{md,mdx}",
    "packages/*/src/**/*.{ts,tsx}",
    "packages/*/*.config.{ts,mts}",
    "plugins/**/*.md",
    ".changeset/*.md"
  ],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/*.d.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "docs/archive/**",
    "docs/research/**",
    "packages/site/src/content/docs/spec/**",
    ".changeset/README.md"
  ],
  "technicalNouns": [
    "adapter",
    "address",
    "axis",
    "comonad",
    "focus",
    "fold",
    "IR",
    "lens",
    "monoid",
    "op",
    "optic",
    "Optional",
    "origin",
    "space",
    "trace",
    "traversal",
    "zipper"
  ],
  "technicalVerbs": [],
  "properNouns": [
    "ASD",
    "ASD-STE100",
    "Claude",
    "GitHub",
    "Graph",
    "Jqy",
    "pnpm",
    "Simplified Technical English",
    "TSDoc",
    "TypeScript",
    "Vex"
  ]
}
