{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mark1russell7.github.io/vex/ir.schema.json",
  "title": "Vex expression",
  "description": "A Vex program as JSON data. The function isExpr of @mark1russell7/vex accepts the same values. Refer to https://mark1russell7.github.io/vex/reference/ir/.",
  "$ref": "#/$defs/expr",
  "$defs": {
    "expr": {
      "oneOf": [
        {
          "$ref": "#/$defs/lit"
        },
        {
          "$ref": "#/$defs/ref"
        },
        {
          "$ref": "#/$defs/app"
        },
        {
          "$ref": "#/$defs/let"
        },
        {
          "$ref": "#/$defs/var"
        },
        {
          "$ref": "#/$defs/call"
        },
        {
          "$ref": "#/$defs/rec"
        },
        {
          "$ref": "#/$defs/each"
        },
        {
          "$ref": "#/$defs/fold"
        },
        {
          "$ref": "#/$defs/iterate"
        },
        {
          "$ref": "#/$defs/ext"
        }
      ]
    },
    "lit": {
      "description": "A literal value.",
      "type": "object",
      "required": [
        "tag",
        "value"
      ],
      "properties": {
        "tag": {
          "const": "lit"
        },
        "value": true
      }
    },
    "ref": {
      "description": "The field at a dotted path, in the record at the address 'at' from the focus.",
      "type": "object",
      "required": [
        "tag",
        "path"
      ],
      "properties": {
        "tag": {
          "const": "ref"
        },
        "path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "at": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/move"
          }
        }
      }
    },
    "app": {
      "description": "An op applied to the values of the arguments. For a method op, the first argument is the receiver.",
      "type": "object",
      "required": [
        "tag",
        "op",
        "args"
      ],
      "properties": {
        "tag": {
          "const": "app"
        },
        "op": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expr"
          }
        }
      }
    },
    "let": {
      "description": "The body, with names bound to the values of the bindings. A binding can be a function (FN.BIND).",
      "type": "object",
      "required": [
        "tag",
        "bind",
        "body"
      ],
      "properties": {
        "tag": {
          "const": "let"
        },
        "bind": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/expr"
              },
              {
                "$ref": "#/$defs/fn"
              }
            ]
          }
        },
        "body": {
          "$ref": "#/$defs/expr"
        }
      }
    },
    "var": {
      "description": "The value of a bound name.",
      "type": "object",
      "required": [
        "tag",
        "name"
      ],
      "properties": {
        "tag": {
          "const": "var"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "fn": {
      "description": "A function with parameters: only a binding of let. Its body evaluates at each call. A function cannot call itself.",
      "type": "object",
      "required": [
        "tag",
        "params",
        "body"
      ],
      "properties": {
        "tag": {
          "const": "fn"
        },
        "params": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "body": {
          "$ref": "#/$defs/expr"
        }
      }
    },
    "call": {
      "description": "The body of the bound function 'fn' at this position, with the values of the arguments for its parameters.",
      "type": "object",
      "required": [
        "tag",
        "fn",
        "args"
      ],
      "properties": {
        "tag": {
          "const": "call"
        },
        "fn": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expr"
          }
        }
      }
    },
    "rec": {
      "description": "A record of the values of the fields.",
      "type": "object",
      "required": [
        "tag",
        "fields"
      ],
      "properties": {
        "tag": {
          "const": "rec"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/expr"
          }
        }
      }
    },
    "each": {
      "description": "A list: the body at each target of the axis. With the address 'at', the axis finds its targets from the key of the address, not from the focus.",
      "type": "object",
      "required": [
        "tag",
        "axis",
        "body"
      ],
      "properties": {
        "tag": {
          "const": "each"
        },
        "axis": {
          "$ref": "#/$defs/axis"
        },
        "as": {
          "description": "The names of the item and of its index, for the axis 'list' only. The names are visible in 'body' and 'step', not in the test of 'where'.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "body": {
          "$ref": "#/$defs/expr"
        },
        "at": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/move"
          }
        }
      }
    },
    "fold": {
      "description": "A loop over the targets of the axis, in order. 'init' gives the names of the loop and their first values at the node. 'step' gives the next values of some of these names, at each target, and each name of 'step' must be a name of 'init'. 'result' gives the value with the last values.",
      "type": "object",
      "required": [
        "tag",
        "axis",
        "init",
        "step",
        "result"
      ],
      "properties": {
        "tag": {
          "const": "fold"
        },
        "axis": {
          "$ref": "#/$defs/axis"
        },
        "as": {
          "description": "The names of the item and of its index, for the axis 'list' only. The names are visible in 'body' and 'step', not in the test of 'where'.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "init": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/expr"
          }
        },
        "step": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/expr"
          }
        },
        "result": {
          "$ref": "#/$defs/expr"
        },
        "at": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/move"
          }
        }
      }
    },
    "iterate": {
      "description": "A loop of up to 'limit' steps at the node. 'init' gives the names of the loop and their first values. 'step' gives the next values of some of these names, and each name of 'step' must be a name of 'init'. A true 'until' stops the loop, and with no true test the value is #NUM!. 'result' gives the value with the last values.",
      "type": "object",
      "required": [
        "tag",
        "limit",
        "init",
        "step",
        "result"
      ],
      "properties": {
        "tag": {
          "const": "iterate"
        },
        "limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "init": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/expr"
          }
        },
        "step": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/expr"
          }
        },
        "until": {
          "$ref": "#/$defs/expr"
        },
        "result": {
          "$ref": "#/$defs/expr"
        }
      }
    },
    "ext": {
      "description": "An extension node. The handler of 'kind' gives its value. A sheet cell reference has the kind 'vex.cell'.",
      "type": "object",
      "required": [
        "tag",
        "kind",
        "data"
      ],
      "properties": {
        "tag": {
          "const": "ext"
        },
        "kind": {
          "type": "string"
        },
        "data": true
      }
    },
    "move": {
      "description": "One move of an address. The moves apply in order, from the focus. The key of key and the position of index can be an expression, which evaluates before the moves.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "t",
            "key"
          ],
          "properties": {
            "t": {
              "const": "key"
            },
            "key": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/expr"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "t",
            "i"
          ],
          "properties": {
            "t": {
              "const": "index"
            },
            "i": {
              "oneOf": [
                {
                  "type": "integer"
                },
                {
                  "$ref": "#/$defs/expr"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "t"
          ],
          "properties": {
            "t": {
              "const": "other"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "t",
            "d"
          ],
          "properties": {
            "t": {
              "const": "offset"
            },
            "d": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "t"
          ],
          "properties": {
            "t": {
              "const": "origin"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "t"
          ],
          "properties": {
            "t": {
              "const": "parent"
            }
          }
        }
      ]
    },
    "axis": {
      "description": "The relation between a position and the targets that a body reads.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "t"
          ],
          "properties": {
            "t": {
              "const": "all"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "t"
          ],
          "properties": {
            "t": {
              "const": "others"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "t"
          ],
          "properties": {
            "t": {
              "const": "other"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "t",
            "n"
          ],
          "properties": {
            "t": {
              "const": "neighbors"
            },
            "n": {
              "enum": [
                4,
                8
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "t",
            "from",
            "to"
          ],
          "properties": {
            "t": {
              "const": "window"
            },
            "from": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "to": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        {
          "type": "object",
          "required": [
            "t",
            "name"
          ],
          "properties": {
            "t": {
              "const": "table"
            },
            "name": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "t"
          ],
          "properties": {
            "t": {
              "const": "children"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "t"
          ],
          "properties": {
            "t": {
              "const": "ancestors"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "t"
          ],
          "properties": {
            "t": {
              "const": "descendants"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "t"
          ],
          "properties": {
            "t": {
              "const": "siblings"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "t"
          ],
          "properties": {
            "t": {
              "const": "successors"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "t"
          ],
          "properties": {
            "t": {
              "const": "predecessors"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "t"
          ],
          "properties": {
            "t": {
              "const": "reachable"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "t",
            "list"
          ],
          "properties": {
            "t": {
              "const": "list"
            },
            "list": {
              "$ref": "#/$defs/expr"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "t",
            "axis"
          ],
          "properties": {
            "t": {
              "const": "reverse"
            },
            "axis": {
              "allOf": [
                {
                  "$ref": "#/$defs/axis"
                },
                {
                  "not": {
                    "type": "object",
                    "required": [
                      "t"
                    ],
                    "properties": {
                      "t": {
                        "enum": [
                          "where",
                          "reverse",
                          "table"
                        ]
                      }
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "t",
            "axis",
            "test"
          ],
          "properties": {
            "t": {
              "const": "where"
            },
            "axis": {
              "$ref": "#/$defs/axis"
            },
            "test": {
              "$ref": "#/$defs/expr"
            }
          }
        }
      ]
    }
  }
}
