{
  "$schema": "https://json.schemastore.org/package",
  "name": "@vex/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "start": "tsx src/main.ts",
