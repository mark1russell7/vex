{
  "$schema": "https://json.schemastore.org/package",
  "name": "@vex/formula",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "description": "The formula language of the sheet app: formulas like Excel, compiled to the Vex IR.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mark1russell7/vex": "workspace:*",
    "@mark1russell7/vex-domains": "workspace:*"
  },
  "devDependencies": {
    "@mark1russell7/cue": "github:mark1russell7/cue",
    "@mark1russell7/vex-testkit": "workspace:*",
    "@types/node": "^26.6.4",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
